{
  // Which concepts the journey page tracks, and how each one is proven from the code.
  //
  //   "detect": "auto:<feature>"   a feature the Roslyn walker recognises (tools/JourneyGen/FeatureWalker.cs)
  //             "regex:<pattern>"  matched against the text of every .cs file
  //             "path:<fragment>"  matched against every file path in the repo
  //             "manual"           roadmap only; never ticks itself
  //
  // Several detectors can be listed; any one matching marks the concept covered.
  "title": "My .NET Journey",
  "tagline": "A running record of the C# and .NET ground I have actually covered, generated from this repository on every push.",

  // Who actually wrote each surviving line, counted with `git blame`.
  //
  // Default is "you": a line only counts as AI or scaffold when something below
  // says so. Going forward the trailer in `aiMarkers` does this automatically —
  // put it in any commit message where AI wrote code and the line moves bucket.
  // The learning plan my manager set, with my own declared status for each item.
  //
  // Status is DECLARED by me ("done" / "in-progress" / "not-started") — the tool does
  // not infer it. The detectors are separate: they look for evidence in the code and
  // the page shows both, so a "done" with nothing behind it is visible rather than
  // hidden. Replace `items` after each review and bump the two dates.
  "assignment": {
    "title": "Learning plan from my manager",
    "source": "Set by my manager",
    "assignedOn": "2026-08-25",
    "reviewOn": "2026-09-22",
    "note": "Reviewed at each follow-up meeting; the list is replaced with a new one based on the feedback.",
    "items": [
      {
        "label": "DI & IoC",
        "status": "done",
        "detect": [
          "regex:Add(Scoped|Singleton|Transient)\\b",
          "regex:\\b(IServiceProvider|IServiceCollection|GetRequiredService)\\b"
        ]
      },
      {
        "label": "List, IList and IEnumerable",
        "status": "done",
        "notes": "the trade-off between exposing a concrete list and an abstraction",
        "parts": [
          { "label": "List<T>",          "detect": "regex:\\bList<" },
          { "label": "IReadOnlyList<T>", "detect": "regex:\\bIReadOnlyList[<\\s]" },
          { "label": "IList<T>",         "detect": "regex:\\bIList[<\\s]" },
          { "label": "IEnumerable<T>",   "detect": "regex:\\bIEnumerable[<\\s]" }
        ]
      },
      {
        "label": "Async",
        "status": "done",
        "detect": ["auto:async-await", "auto:task-based-async"]
      },
      {
        "label": "ILogger",
        "status": "in-progress",
        "detect": ["regex:\\bILogger\\b", "regex:Microsoft\\.Extensions\\.Logging"]
      },
      {
        "label": "Structured logging",
        "status": "in-progress",
        "notes": "message templates with named placeholders, not string interpolation",
        "detect": "regex:\\.Log\\w+\\(\"[^\"]*\\{[A-Za-z]"
      },
      {
        "label": "Service Bus",
        "status": "in-progress",
        "detect": ["regex:ServiceBus", "regex:QueueClient", "regex:Azure\\.Messaging"]
      },
      {
        "label": "IDisposable",
        "status": "in-progress",
        "parts": [
          { "label": "Consumed with using", "detect": "auto:using-idisposable" },
          { "label": "Implemented myself",  "detect": ["regex:\\bvoid\\s+Dispose\\s*\\(", "regex:\\bIDisposable\\b"] }
        ]
      }
    ]
  },

  "provenance": {
    "enabled": true,

    // A commit message containing any of these counts as AI-written.
    "aiMarkers": [
      "Co-Authored-By: Claude",
      "Assisted-By: Claude",
      "Co-Authored-By: Copilot",
      "Assisted-By: AI"
    ],

    // History written before the trailer convention existed, declared by hand.
    // 00e0f1f added tools/JourneyGen, which Claude wrote in full.
    "aiCommits": ["00e0f1f"],

    // Everything under these paths is AI-written regardless of commit.
    "aiPaths": ["tools/"],

    // `dotnet new` output, not authored by anyone. d56cc61 scaffolded both web
    // projects; every .cs file it added is still byte-identical to the template.
    "scaffoldCommits": ["d56cc61"],
    "scaffoldPaths": [],

    "botAuthors": ["github-actions[bot]", "dependabot"],

    // Measured for provenance even though the code stats above skip them.
    "extraPaths": ["tools"]
  },

  "diagram": {
